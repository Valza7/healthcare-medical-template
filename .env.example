# =============================================================================
# HEALTHCARE MEDICAL TEMPLATE - ENVIRONMENT VARIABLES
# =============================================================================
# IMPORTANT: Never commit the actual .env file to version control
# This is a template file showing all required environment variables
#
# HIPAA COMPLIANCE NOTE:
# - Ensure all service providers have signed Business Associate Agreements (BAAs)
# - Use production credentials only in production environments
# - Rotate keys regularly
# - Use secret management services in production (AWS Secrets Manager, etc.)
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="HealthCare Medical Practice"
NODE_ENV=development

# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------
# Get your keys from: https://clerk.com/
# REQUIRED: Ensure Clerk has a signed BAA before handling PHI
# Configure MFA in Clerk Dashboard: Settings > Authentication > Multi-factor

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/patient-portal/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/patient-portal/dashboard

# Clerk Webhooks (for user sync)
# CLERK_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Convex Database
# -----------------------------------------------------------------------------
# Get your URL from: https://convex.dev/
# REQUIRED: Ensure Convex has a signed BAA before handling PHI
# Enable encryption at rest in Convex dashboard

CONVEX_DEPLOYMENT=dev:...
NEXT_PUBLIC_CONVEX_URL=https://....convex.cloud

# -----------------------------------------------------------------------------
# Email Service (HIPAA-Compliant)
# -----------------------------------------------------------------------------
# Use HIPAA-compliant email service like Paubox, MailHippo, or similar
# REQUIRED: Must have BAA from email provider

# EMAIL_PROVIDER=paubox
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=HealthCare Medical Practice

# -----------------------------------------------------------------------------
# SMS Service (HIPAA-Compliant)
# -----------------------------------------------------------------------------
# Use HIPAA-compliant SMS service like Twilio with BAA
# REQUIRED: Must have BAA from SMS provider
# Only use for appointment reminders, not PHI

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=

# -----------------------------------------------------------------------------
# File Storage (HIPAA-Compliant)
# -----------------------------------------------------------------------------
# For medical documents, insurance cards, etc.
# REQUIRED: Must have BAA from storage provider
# Use AWS S3 with encryption, Azure Blob Storage, or similar

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=healthcare-medical-documents
# AWS_S3_ENCRYPTION=AES256

# Alternative: Uploadthing (check BAA availability)
# UPLOADTHING_SECRET=
# UPLOADTHING_APP_ID=

# -----------------------------------------------------------------------------
# Payment Processing (PCI-Compliant)
# -----------------------------------------------------------------------------
# Use Stripe with HIPAA-compliant configuration
# REQUIRED: Must have BAA from payment processor

# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Telehealth Platform
# -----------------------------------------------------------------------------
# Use HIPAA-compliant video service (Twilio Video, Agora, Zoom Healthcare)
# REQUIRED: Must have BAA from video provider

# TELEHEALTH_PROVIDER=twilio
# TWILIO_VIDEO_API_KEY=
# TWILIO_VIDEO_API_SECRET=
# TWILIO_VIDEO_ACCOUNT_SID=

# Alternative: Agora
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=

# Alternative: Zoom Healthcare API (requires Healthcare account)
# ZOOM_API_KEY=
# ZOOM_API_SECRET=

# -----------------------------------------------------------------------------
# Analytics (Privacy-Focused)
# -----------------------------------------------------------------------------
# Use privacy-focused analytics that don't track PHI
# Consider: Plausible, Fathom, or self-hosted Matomo

# NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# -----------------------------------------------------------------------------
# Error Tracking & Monitoring
# -----------------------------------------------------------------------------
# Use with caution - ensure no PHI is logged
# Configure data scrubbing for all user data

# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# EHR Integration (Optional)
# -----------------------------------------------------------------------------
# For integration with Electronic Health Record systems
# Epic, Cerner, etc. via HL7/FHIR

# EHR_SYSTEM=epic
# EHR_API_URL=
# EHR_CLIENT_ID=
# EHR_CLIENT_SECRET=
# FHIR_BASE_URL=

# -----------------------------------------------------------------------------
# e-Prescribing (Optional)
# -----------------------------------------------------------------------------
# Surescripts or similar e-prescribing system

# SURESCRIPTS_USER_ID=
# SURESCRIPTS_PASSWORD=
# SURESCRIPTS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Insurance Verification (Optional)
# -----------------------------------------------------------------------------
# For real-time insurance eligibility verification

# INSURANCE_API_PROVIDER=change-healthcare
# INSURANCE_API_KEY=
# INSURANCE_API_URL=

# -----------------------------------------------------------------------------
# Encryption Keys
# -----------------------------------------------------------------------------
# For encrypting sensitive data at application level
# Generate with: openssl rand -base64 32

# ENCRYPTION_KEY=
# JWT_SECRET=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# For API rate limiting (Upstash Redis recommended)

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# For gradual rollout of features

# NEXT_PUBLIC_FEATURE_TELEHEALTH_ENABLED=true
# NEXT_PUBLIC_FEATURE_ONLINE_PAYMENTS_ENABLED=true
# NEXT_PUBLIC_FEATURE_PRESCRIPTION_REFILLS_ENABLED=true
# NEXT_PUBLIC_FEATURE_HEALTH_TRACKING_ENABLED=true

# -----------------------------------------------------------------------------
# Compliance & Security
# -----------------------------------------------------------------------------
# Session timeout in minutes (HIPAA recommends 15 minutes of inactivity)
SESSION_TIMEOUT_MINUTES=15

# Maximum login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Password minimum length
PASSWORD_MIN_LENGTH=12

# Require MFA for all users
REQUIRE_MFA=true

# Enable audit logging
ENABLE_AUDIT_LOGGING=true

# -----------------------------------------------------------------------------
# Development Only
# -----------------------------------------------------------------------------
# These should be removed or set to false in production

# NEXT_PUBLIC_SHOW_DEBUG_INFO=false
# DISABLE_RATE_LIMITING=false
# SKIP_EMAIL_VERIFICATION=false
